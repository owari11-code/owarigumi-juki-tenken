# Cloudflare Pages が全ページに付けるHTTPヘッダー。
# 外部への読み込み先を必要最小限に絞り、埋め込みや型の推測を禁止する。

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; media-src 'self' blob:; connect-src 'self' https://challenges.cloudflare.com; worker-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=15552000; includeSubDomains

# 設定ファイルと処理本体は、更新がすぐ反映されるようにする
/js/*
  Cache-Control: public, max-age=300, must-revalidate
/css/*
  Cache-Control: public, max-age=300, must-revalidate

# データのやり取りは絶対に保存しない
/api/*
  Cache-Control: no-store
